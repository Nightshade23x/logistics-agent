# Optional Gemini smart-answer configuration.
# Do not put real keys in this example file.
#
# PowerShell:
# $env:GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# $env:GEMINI_MODEL="gemini-2.5-flash"
#
# The Streamlit frontend works without this key, but custom answers will use
# deterministic fallback text instead of Gemini synthesis.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Robust request interpreter. The default "fallback" mode calls Gemini only
# when the deterministic route is weak, malformed, or likely contains typos.
# Set to "always" to interpret every non-empty free-text request, or "off" to
# use only deterministic parsing.
LLM_INTERPRETER_MODE=fallback
LLM_INTERPRETER_TIMEOUT_SECONDS=8
LLM_INTERPRETER_MIN_CONFIDENCE=0.65
